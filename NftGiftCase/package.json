{
  "name": "nftgiftcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram Mini App: digital gift cases, Stars payments, upgrades and event pass.",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute nftgiftcase-db --local --file=./db/0001_initial.sql",
    "db:remote": "wrangler d1 execute nftgiftcase-db --remote --file=./db/0001_initial.sql",
    "check": "node --check backend/app.js && node --check backend/worker.js && node --check frontend/app.js",
    "telegram:setup": "node --env-file=.env scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
