{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nftgiftcase-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE_WITH_CLOUDFLARE_PAGES_DOMAIN",
    "SUBSCRIPTION_CHANNEL": "@NftGiftCaseNews",
    "ADMIN_ID": "1080484217",
    "ADMIN_USERNAME": "sork1555",
    "SUPPORT_USERNAME": "sork1555",
    "BOT_USERNAME": "REPLACE_WITH_BOT_USERNAME",
    "PUBLIC_APP_URL": "https://REPLACE_WITH_CLOUDFLARE_PAGES_DOMAIN",
    "REFERRAL_PERCENT": "5",
    "DEV_AUTH": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nftgiftcase-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
